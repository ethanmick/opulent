{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "vitest", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "ignorePatterns": ["dist", "release", "renderer/dist"]
}
