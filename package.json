{
  "name": "opulent",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p renderer",
    "smoke": "node scripts/smoke.mjs",
    "start": "electron .",
    "dev:renderer": "vite",
    "dev:main": "tsc -w --preserveWatchOutput",
    "electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"pnpm:dev:renderer\" \"pnpm:dev:main\" \"pnpm:electron\"",
    "pack": "electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "com.ethanmick.opulent",
    "npmRebuild": false,
    "files": [
      "dist/**",
      "renderer/dist/**",
      "package.json",
      "!node_modules/better-sqlite3/{build,deps,src}/**",
      "!node_modules/better-sqlite3/binding.gyp"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/*.node"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/better-sqlite3/prebuilds/darwin-*.node"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wait-on": "9.5.1"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "electron-winstaller"
    ]
  }
}
